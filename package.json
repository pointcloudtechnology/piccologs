{
    "name": "@pointcloudtechnology/piccologs",
    "version": "0.3.0",
    "description": "Simple CLI tool for generating changelogs; inspired by changesets",
    "keywords": [
        "changelogs"
    ],
    "author": "Point Cloud Technology GmbH",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pointcloudtechnology/piccologs.git"
    },
    "type": "module",
    "module": "index.js",
    "exports": {
        ".": {
            "import": "./index.js"
        }
    },
    "files": [
        "bin",
        "src",
        "index.js"
    ],
    "bin": {
        "picco": "bin/picco.mjs"
    },
    "scripts": {
        "execute": "node bin/picco.mjs"
    },
    "dependencies": {
        "@clack/prompts": "1.2.0",
        "human-id": "4.1.3",
        "picocolors": "1.1.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
